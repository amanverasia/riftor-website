---
import Layout from '../layouts/Layout.astro';
import PixelArt from '../components/PixelArt.astro';
import PageWidgets from '../components/PageWidgets.astro';
---

<Layout>
  <PageWidgets />
  <div class="border-b border-void-border bg-void-panel px-4 py-2 text-center silkscreen text-[10px] sm:text-xs tracking-wider text-rift-cyan">
    STANDALONE CLI · PI RUNTIME EMBEDDED · AUTHORIZED ASSESSMENTS
  </div>

  <nav class="sticky top-0 z-50 border-b-2 border-void-border-bright bg-void/95 backdrop-blur-sm">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 silkscreen text-rift-amber">
        <PixelArt name="terminal" size={22} /> RIFTOR
      </a>
      <div class="flex items-center gap-5 text-sm text-rift-dim">
        <a href="#design" class="hover:text-rift-amber transition-colors">Design</a>
        <a href="#roadmap" class="hover:text-rift-amber transition-colors">Roadmap</a>
        <a href="https://github.com/amanverasia/riftor" target="_blank" rel="noopener noreferrer" class="hover:text-rift-amber transition-colors">Source</a>
      </div>
    </div>
  </nav>

  <main class="pixel-grid">
    <section class="px-4 sm:px-6 pt-16 sm:pt-24 pb-20">
      <div class="max-w-5xl mx-auto grid md:grid-cols-[1fr_auto] gap-10 items-center">
        <div>
          <p class="silkscreen text-xs text-rift-cyan mb-5">LOCAL-FIRST SECURITY WORKFLOW</p>
          <h1 class="silkscreen text-3xl sm:text-5xl leading-tight text-rift-text mb-6">
            A harness for security work.<br />
            <span class="text-rift-amber">Built around your control.</span>
          </h1>
          <p class="text-rift-muted text-base sm:text-lg leading-relaxed max-w-2xl mb-8">
            Riftor is a standalone terminal application for authorized security assessments.
            It embeds Pi's agent runtime and adds the engagement controls, scoped tools,
            evidence, and reporting that security work needs.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="https://github.com/amanverasia/riftor" target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3 border-2 border-rift-amber text-rift-amber silkscreen text-xs hover:bg-rift-amber/10 transition-colors">
              VIEW SOURCE <span aria-hidden="true">↗</span>
            </a>
            <a href="#roadmap" class="inline-flex items-center px-5 py-3 border-2 border-void-border-bright text-rift-muted silkscreen text-xs hover:border-rift-cyan hover:text-rift-cyan transition-colors">
              SEE THE BUILD PLAN
            </a>
          </div>
          <p class="mt-6 text-xs text-rift-dim">Early rebuild · Not yet released · Authorized testing only</p>
        </div>
        <div class="hidden md:block pixel-idle"><PixelArt name="shield" size={144} /></div>
      </div>
    </section>

    <section id="design" class="border-t-2 border-void-border-bright py-16 px-4 sm:px-6">
      <div class="max-w-5xl mx-auto">
        <div class="flex items-center gap-3 mb-8">
          <span class="silkscreen text-xs text-rift-amber">THE DESIGN</span>
          <span class="flex-1 border-t border-void-border"></span>
          <span class="silkscreen text-[10px] text-rift-dim">PI UNDER THE HOOD</span>
        </div>
        <div class="grid md:grid-cols-3 gap-4">
          <article class="game-frame p-5">
            <div class="mb-4"><PixelArt name="shield" size={36} /></div>
            <h2 class="silkscreen text-xs text-rift-cyan mb-3">AUTHORIZATION & SCOPE</h2>
            <p class="text-sm text-rift-muted leading-relaxed">Every engagement declares its authorized assets, exclusions, allowed activities, and expiration before active work can begin.</p>
          </article>
          <article class="game-frame p-5">
            <div class="mb-4"><PixelArt name="key" size={36} /></div>
            <h2 class="silkscreen text-xs text-rift-amber mb-3">POLICY AT EXECUTION</h2>
            <p class="text-sm text-rift-muted leading-relaxed">Tool calls pass through one policy gateway. Unknown targets and unavailable approval are denied by default.</p>
          </article>
          <article class="game-frame p-5">
            <div class="mb-4"><PixelArt name="terminal" size={36} /></div>
            <h2 class="silkscreen text-xs text-rift-green mb-3">EVIDENCE & REPORTS</h2>
            <p class="text-sm text-rift-muted leading-relaxed">Actions, evidence, and findings stay linked so an operator can review what happened and produce a portable report.</p>
          </article>
        </div>
        <p class="mt-5 text-xs text-rift-dim leading-relaxed">Pi is the embedded agent runtime. Riftor is installed and run as its own application; no separate Pi CLI install is required.</p>
      </div>
    </section>

    <section id="roadmap" class="border-t-2 border-void-border-bright py-16 px-4 sm:px-6">
      <div class="max-w-5xl mx-auto">
        <div class="flex items-center gap-3 mb-8">
          <span class="silkscreen text-xs text-rift-amber">BUILD ROADMAP</span>
          <span class="flex-1 border-t border-void-border"></span>
        </div>
        <ol class="space-y-3">
          {[
            ['01', 'Standalone Pi-powered CLI', 'Embed the agent runtime and establish the application shell.'],
            ['02', 'Engagement authorization', 'Represent scope, exclusions, allowed activities, and expiry.'],
            ['03', 'Enforced tool gateway', 'Apply policy and approvals at every tool execution boundary.'],
            ['04', 'Evidence and reporting', 'Capture provenance, manage findings, and export reviewable reports.'],
          ].map(([number, title, description]) => (
            <li class="game-frame p-4 sm:p-5 flex gap-4 items-start">
              <span class="silkscreen text-sm text-rift-cyan">{number}</span>
              <div>
                <h2 class="silkscreen text-xs text-rift-text mb-2">{title}</h2>
                <p class="text-sm text-rift-muted">{description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="border-t-2 border-void-border-bright py-14 px-4 sm:px-6 text-center">
      <p class="silkscreen text-xs text-rift-text mb-3">OPEN SOURCE · GPL-3.0-OR-LATER</p>
      <p class="text-sm text-rift-dim mb-6">Built for authorized security work. Riftor is under active rebuild.</p>
      <a href="https://github.com/amanverasia/riftor" target="_blank" rel="noopener noreferrer" class="silkscreen text-xs text-rift-amber hover:text-rift-cyan transition-colors">CONTRIBUTE ON GITHUB ↗</a>
    </section>
  </main>

  <footer class="border-t-2 border-void-border-bright py-6 px-4 sm:px-6 text-center silkscreen text-[10px] text-rift-dim">
    RIFTOR · <a class="hover:text-rift-muted" href="https://github.com/amanverasia">AMANVERASIA</a> · AUTHORIZED ASSESSMENTS ONLY
  </footer>
</Layout>
